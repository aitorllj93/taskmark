{
  "name": "taskmark",
  "version": "0.1.0",
  "description": "A TypeScript library for parsing and stringifying TaskMark-v1 formatted tasks",
  "author": "Aitor Llamas Jiménez <aitorllj93@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "benchmark": "tsx benchmark/parse.bench.ts",
    "docs:serve": "docsify serve docs",
    "docs:init": "docsify init ./docs"
  },
  "keywords": ["typescript", "library", "taskmark", "task", "parser", "markdown", "task-management", "productivity"],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aitorllj93/taskmark.git"
  },
  "bugs": {
    "url": "https://github.com/aitorllj93/taskmark/issues"
  },
  "homepage": "https://github.com/aitorllj93/taskmark#readme",
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "docsify-cli": "^4.4.4",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
